[nemesis]
version=1.0
id=gen5w.kr.portable
name=Gen5W KR - CarPlay HUD
package-version=0.3.75
short-desc=Guarded automatic wireless operation; independent USB disable
depends=!gen5w.kr.bridge,!gen5w.kr.core,!wireless.projection,!enhanced.projection,!projection.tbt
types=application,service
preinstall=package-pre.sh
postinstall=package-post.sh
preuninstall=package-preun.sh

[app.0]
kind=apk
path=app/wireless-host.apk
package=kr.gen5w.wirelesshost

[app.1]
kind=apk
path=app/gen5w-core.apk
package=kr.gen5w.core

[service.0]
name=boot
kind=sh
path=service.sh
uid=root
mode=background

[service.1]
name=ui
kind=sh
path=ui.sh
uid=root
mode=background

[service.2]
name=rescue
kind=sh
path=rescue-watch.sh
uid=root
mode=restart

[service.3]
name=debug
kind=sh
path=debug.sh
uid=root
mode=background
