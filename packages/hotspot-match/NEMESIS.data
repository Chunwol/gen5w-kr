[nemesis]
version=1.0
id=gen5w.kr.hotspot
name=Gen5W KR - match the hotspot name to CarPlay
types=application,service
preinstall=scripts/pre.sh
postinstall=scripts/profile-post.sh
preuninstall=scripts/profile-preun.sh
postuninstall=scripts/postun.sh

[app.0]
kind=sh
path=bin/run.sh
uid=system

[service.0]
name=match
kind=sh
path=svc/match.sh
uid=system
mode=once

[service.1]
name=profile-ready
kind=sh
path=scripts/profile-ready.sh
uid=root
mode=once
